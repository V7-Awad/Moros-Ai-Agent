# ============================================================
# Moros AI — Environment Configuration & LLM Provider Keys
# ============================================================
# Copy this file to .env and fill in your desired settings:
#   copy .env.example .env

# ------------------------------------------------------------
# 1. DeepSeek API (Recommended for Bug Bounty reasoning)
# ------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
# Optional: DEEPSEEK_MODEL=deepseek-reasoner

# ------------------------------------------------------------
# 2. OpenAI / Anthropic / Gemini / Groq / OpenRouter / Ollama
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# OLLAMA_BASE_URL=http://localhost:11434/v1
# MOROS_LLM_PROVIDER=deepseek

# ------------------------------------------------------------
# 3. Authenticated Bug Bounty Session Credentials
# ------------------------------------------------------------
# Pass your active session cookie or Bearer token to test authenticated surfaces:
# MOROS_AUTH_COOKIE=session=xyz123; user_id=456; remember_token=abc
# MOROS_AUTH_HEADER=Authorization: Bearer eyJhbGciOi...
# MOROS_BUG_BOUNTY_ID=hackerone-yourhandle

# ------------------------------------------------------------
# 4. Strict Bug Bounty Scope Policies
# ------------------------------------------------------------
# MOROS_IN_SCOPE=*.target.com,target.com
# MOROS_OUT_OF_SCOPE=blog.target.com,zendesk.com,status.target.com

# ------------------------------------------------------------
# 5. Live Webhook Alerts (Discord, Telegram, Slack)
# ------------------------------------------------------------
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=987654321
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
