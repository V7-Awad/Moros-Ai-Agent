# Git & VCS
.git
.gitignore

# Secrets & local environment files (never bake credentials into image)
.env
.env.*
!.env.example

# Target workspaces & engagement outputs (mounted at runtime)
targets/*
!targets/.gitkeep

# Python bytecode & caches
__pycache__
**/__pycache__
*.py[cod]
*.pyc
**/__pycache__/*.pyc
**/*.pyc
*.pyo
*$py.class
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov/

# Local virtual environments
venv/
.venv/
env/

# Reference materials, PDFs, local DBs & logs
_ref
docs/*.pdf
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.log
*.tmp

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
